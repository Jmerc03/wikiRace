{
  "manifest_version": 3,
  "name": "WikiRace — Wikipedia Bingo",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Play bingo by navigating Wikipedia",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://en.wikipedia.org/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://en.wikipedia.org/*"],
      "js": ["content.js"]
    }
  ]
}
