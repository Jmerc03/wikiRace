{
  "name": "wikipedia-bingo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:extension && npm run package:extension",
    "build:shared": "npm run --workspace=@bingo/shared build",
    "build:game-engine": "npm run build:shared && npm run --workspace=@bingo/game-engine build",
    "build:api": "npm run build:game-engine && npm run --workspace=api build",
    "build:extension": "npm run build:shared && npm run --workspace=extension build",
    "dev:api": "npm run build:game-engine && node scripts/dev-api.mjs",
    "prisma:generate": "npm run --workspace=api prisma:generate",
    "prisma:validate": "npm run --workspace=api prisma:validate",
    "prisma:migrate:dev": "npm run --workspace=api prisma:migrate:dev --",
    "prisma:studio": "npm run --workspace=api prisma:studio",
    "test": "npm run test:shared && npm run test:game-engine && npm run test:api && npm run test:extension && npm run test:release",
    "test:release": "node --test scripts/test-beta-release.mjs scripts/test-home-beta.mjs",
    "home:beta": "node scripts/home-beta.mjs",
    "test:game-engine": "npm run --workspace=@bingo/game-engine test",
    "test:api": "npm run build:game-engine && npm run --workspace=api test",
    "test:integration": "npm run build:api && node scripts/test-integration.mjs",
    "test:browser": "npm run build && node scripts/test-integration.mjs --browser",
    "test:extension": "npm run build:shared && npm run --workspace=extension test",
    "browser:install": "node scripts/browser-install.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "release:beta": "node scripts/release-beta.mjs",
    "setup:local": "node scripts/local.mjs setup",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "local:status": "node scripts/local.mjs status",
    "prisma:migrate:deploy": "npm run --workspace=api prisma:migrate:deploy",
    "test:live": "npm run build && node scripts/test-integration.mjs --qualification=live",
    "test:endurance": "npm run build && node scripts/test-integration.mjs --qualification=endurance",
    "test:upgrade": "node scripts/test-integration.mjs --qualification=upgrade",
    "test:live:generated": "npm run build && node scripts/test-integration.mjs --qualification=live-generated",
    "test:worker": "npm run build && node scripts/test-integration.mjs --qualification=worker",
    "test:package": "npm run build:extension && node scripts/verify-package.mjs",
    "local:backup": "node scripts/backup-local.mjs",
    "test:backup": "npm run build:api && node scripts/test-integration.mjs --qualification=backup",
    "test:sessions": "npm run build:api && node scripts/test-integration.mjs --qualification=sessions",
    "test:shared": "npm run --workspace=@bingo/shared test",
    "test:database:fault": "npm run build:api && node scripts/test-integration.mjs --qualification=database-fault",
    "test:multiroom": "npm run build:api && node scripts/test-integration.mjs --qualification=multiroom"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.6.0",
    "fflate": "^0.8.3",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13"
  }
}
